#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @environment.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    def Xform "Robot" (
        prepend references = @/home/fang/isaacsim_rm75/assets/usd/rm75_dual_rmg24_sim_1/rm75_dual_rmg24_sim.usda@
    )
    {
        float xformOp:rotateZ = 180
        double3 xformOp:translate = (-1.3, 0.5, 0.24734551877975464)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }
}

